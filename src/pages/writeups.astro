---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const includeDrafts = import.meta.env.DEV;
const writeups = (await getCollection('blog', ({ data }) => includeDrafts || !data.draft))
	.filter((post) => post.data.category === 'CTF Writeups' || post.data.category === 'Security Research')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout
	title="Security writeups - elure"
	description="CTF reasoning, vulnerability research, and reproducible technical notes."
>
	<PageHero
		kicker="Writeups"
		title="CTF and security research writeups."
		description="Technical notes on methods, evidence, reproduction steps, and lessons from CTFs and vulnerability research."
	/>

	<section class="writeups-section">
		<div class="shell writeup-layout">
			<div class="writeup-list">
				{
					writeups.length > 0 ? writeups.map((post) => (
						<a href={`/blog/${post.id}`}>
							<div>
								<p>{post.data.draft ? `Draft preview · ${post.data.category}` : post.data.category}</p>
								<h2>{post.data.title}</h2>
								<span>{post.data.description}</span>
							</div>
							<div class="writeup-meta mono">
								<FormattedDate date={post.data.pubDate} />
								<span>{post.data.tags.join(' / ')}</span>
							</div>
						</a>
					)) : (
						<div class="empty-writeups">
							<h2>{includeDrafts ? 'No writeups or draft previews yet.' : 'No writeups are published yet.'}</h2>
							<p>CTF and security research writeups will appear here when available.</p>
						</div>
					)
				}
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.writeups-section {
		padding: 6rem 0 10rem;
		background: var(--deep-space);
	}

	.writeup-list {
		max-width: 1100px;
		margin-inline: auto;
		border-top: 1px solid var(--line-strong);
	}

	.writeup-list > a {
		display: grid;
		min-height: 240px;
		padding: 2.4rem 0;
		grid-template-columns: 1fr 200px;
		gap: 2rem;
		align-items: end;
		border-bottom: 1px solid var(--line);
		color: var(--starlight);
		text-decoration: none;
	}

	.writeup-list > a:is(:hover, :focus-visible) h2 {
		color: var(--ultraviolet-hot);
	}

	.writeup-list > a p {
		margin: 0 0 0.75rem;
		color: var(--ultraviolet-hot);
		font-size: 0.78rem;
		font-weight: 570;
	}

	.writeup-list h2 {
		font-size: clamp(1.25rem, 2.2vw, 1.9rem);
	}

	.writeup-list h2 + span {
		display: block;
		max-width: 720px;
		margin-top: 1rem;
		color: var(--secondary);
	}

	.writeup-meta {
		display: grid;
		gap: 0.55rem;
		justify-items: end;
		color: var(--quiet);
		font-size: 0.72rem;
		text-align: right;
	}

	.empty-writeups {
		padding: 5rem 0;
	}

	.empty-writeups p {
		color: var(--secondary);
	}

	@media (max-width: 580px) {
		.writeup-list > a {
			grid-template-columns: 1fr;
		}

		.writeup-meta {
			justify-items: start;
			text-align: left;
		}
	}
</style>
