---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const includeDrafts = import.meta.env.DEV;
const entries = (await getCollection('work', ({ data }) => includeDrafts || !data.draft)).sort(
	(a, b) => b.data.start.valueOf() - a.data.start.valueOf(),
);

const year = (value: Date) => value.getUTCFullYear();
const period = (start: Date, end?: Date) =>
	end ? (year(start) === year(end) ? `${year(start)}` : `${year(start)} - ${year(end)}`) : `${year(start)} - Present`;
---

<SiteLayout
	title="Work - elure"
	description="Roles, work experience, and qualifications held by Mihnea-Luca Mărășescu."
>
	<PageHero
		kicker="Work"
		title="Experience and qualifications."
		description="Where I have worked and what I have earned along the way."
	/>

	<section class="work-section">
		<div class="shell">
			{
				entries.length > 0 ? (
					<ol class="work-list">
						{entries.map((entry) => (
							<li class="work-entry">
								<div class="work-period mono">
									<span>{period(entry.data.start, entry.data.end)}</span>
									<span class="work-kind">{entry.data.kind}</span>
								</div>
								<div class="work-main">
									<h2>{entry.data.title}</h2>
									<p class="work-org">
										{entry.data.organisation}
										{entry.data.location && <span> · {entry.data.location}</span>}
									</p>
									<p class="work-description">{entry.data.description}</p>
									<a class="work-link" href={`/work/${entry.id}`}>
										Details<span aria-hidden="true"> →</span>
									</a>
								</div>
							</li>
						))}
					</ol>
				) : (
					<div class="work-empty">
						<h2>Nothing listed yet.</h2>
						<p>Roles and qualifications will appear here as they are added.</p>
					</div>
				)
			}
		</div>
	</section>
</SiteLayout>

<style>
	.work-section {
		padding: 6rem 0 10rem;
		background: var(--deep-space);
	}

	.work-list {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0;
		border-top: 1px solid var(--line-strong);
		list-style: none;
	}

	.work-entry {
		display: grid;
		padding: clamp(2.25rem, 4vw, 3.25rem) 0;
		grid-template-columns: minmax(170px, 0.3fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
		border-bottom: 1px solid var(--line);
	}

	.work-period {
		display: grid;
		gap: 0.4rem;
		color: var(--starlight);
		font-size: 0.85rem;
	}

	.work-kind {
		color: var(--ultraviolet-hot);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.work-main h2 {
		font-size: clamp(1.25rem, 2.2vw, 1.9rem);
	}

	.work-org {
		margin: 0.6rem 0 0;
		color: var(--starlight);
		font-size: 1rem;
		font-weight: 560;
	}

	.work-org span {
		color: var(--secondary);
		font-weight: 400;
	}

	.work-description {
		max-width: 70ch;
		margin: 0.9rem 0 0;
		color: var(--secondary);
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.work-link {
		display: inline-block;
		margin-top: 1.1rem;
		color: var(--starlight);
		font-size: 0.88rem;
		font-weight: 590;
		text-decoration: none;
	}

	.work-link:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.work-empty {
		max-width: 1100px;
		margin-inline: auto;
		padding: 5rem 0;
		border-top: 1px solid var(--line-strong);
	}

	.work-empty h2 {
		font-size: clamp(2.6rem, 5vw, 4.8rem);
	}

	.work-empty p {
		margin: 1.5rem 0 0;
		color: var(--secondary);
	}

	@media (max-width: 760px) {
		.work-entry {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.work-period {
			display: flex;
			align-items: baseline;
			gap: 0.9rem;
		}
	}
</style>
