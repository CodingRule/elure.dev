---
import BaseHead from '../components/BaseHead.astro';
import LiquidDefs from '../components/LiquidDefs.astro';

const FIELD_W = 1600;
const FIELD_H = 1000;

const makeRandom = (seed: number) => () => {
	seed = (seed + 0x6d2b79f5) | 0;
	let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
	t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
	return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const random = makeRandom((Math.random() * 0xffffffff) | 0);

const GLYPHS: Record<string, number[][][]> = {
	C: [[[2, 0.6], [1, 0], [0, 1], [0, 3], [1, 4], [2, 3.4]]],
	E: [[[2, 0], [0, 0], [0, 4], [2, 4]], [[0, 2], [1.5, 2]]],
	F: [[[0, 4], [0, 0], [2, 0]], [[0, 2], [1.5, 2]]],
	I: [[[1, 0], [1, 4]]],
	L: [[[0, 0], [0, 4], [2, 4]]],
	M: [[[0, 4], [0, 0], [1, 2], [2, 0], [2, 4]]],
	N: [[[0, 4], [0, 0], [2, 4], [2, 0]]],
	O: [[[0, 1], [1, 0], [2, 1], [2, 3], [1, 4], [0, 3], [0, 1]]],
	R: [[[0, 4], [0, 0], [1.6, 0], [2, 1], [1.6, 2], [0, 2]], [[1.1, 2], [2, 4]]],
	T: [[[0, 0], [2, 0]], [[1, 0], [1, 4]]],
	U: [[[0, 0], [0, 3], [1, 4], [2, 3], [2, 0]]],
};

type Point = { x: number; y: number };
type Constellation = { strokes: Point[][]; stars: Point[] };

const buildWord = (
	word: string,
	originX: number,
	originY: number,
	unit: number,
	tilt: number,
): Constellation => {
	const radians = (tilt * Math.PI) / 180;
	const cos = Math.cos(radians);
	const sin = Math.sin(radians);
	const strokes: Point[][] = [];
	const stars: Point[] = [];
	let cursor = 0;

	for (const letter of word) {
		for (const stroke of GLYPHS[letter] ?? []) {
			const points = stroke.map(([gx, gy]) => {
				const lx = (cursor + gx) * unit + (random() - 0.5) * unit * 0.18;
				const ly = gy * unit + (random() - 0.5) * unit * 0.18;
				return {
					x: originX + lx * cos - ly * sin,
					y: originY + lx * sin + ly * cos,
				};
			});
			strokes.push(points);
			stars.push(...points);
		}
		cursor += 3.1;
	}

	return { strokes, stars };
};

const SAFE = { x0: 380, y0: 120, x1: 1240, y1: 870 };
type Box = { x: number; y: number; w: number; h: number };


const claimed: Box[] = [
	{ x: 380, y: 210, w: 420, h: 590 }, 
	{ x: 950, y: 630, w: 290, h: 240 }, 
];

const overlapArea = (a: Box, b: Box, pad: number) => {
	const dx = Math.min(a.x + a.w + pad, b.x + b.w) - Math.max(a.x - pad, b.x);
	const dy = Math.min(a.y + a.h + pad, b.y + b.h) - Math.max(a.y - pad, b.y);
	return dx > 0 && dy > 0 ? dx * dy : 0;
};

const placeWord = (word: string): Constellation => {
	const unit = 17 + random() * 7;
	const tilt = (random() - 0.5) * 22;
	const w = word.length * 3.1 * unit;
	const h = 4 * unit;
	const spanX = Math.max(1, SAFE.x1 - SAFE.x0 - w);
	const spanY = Math.max(1, SAFE.y1 - SAFE.y0 - h);

	let best = { x: SAFE.x0, y: SAFE.y0, score: Number.POSITIVE_INFINITY };
	for (let attempt = 0; attempt < 400; attempt++) {
		const x = SAFE.x0 + random() * spanX;
		const y = SAFE.y0 + random() * spanY;
		const score = claimed.reduce(
			(total, box) => total + overlapArea({ x, y, w, h }, box, 44),
			0,
		);
		if (score < best.score) best = { x, y, score };
		if (score === 0) break;
	}

	claimed.push({ x: best.x, y: best.y, w, h });
	return buildWord(word, best.x, best.y, unit, tilt);
};


const WORD_POOL = ['ELURE', 'OMNI', 'CTF', 'ROOT', 'NULL'];
const words: Constellation[] = [placeWord(WORD_POOL[Math.floor(random() * WORD_POOL.length)])];

const chains: Constellation[] = Array.from({ length: 8 }, () => {
	const count = 2 + Math.floor(random() * 9);
	const points: Point[] = [];
	let x = SAFE.x0;
	let y = SAFE.y0;

	for (let attempt = 0; attempt < 80; attempt++) {
		x = SAFE.x0 + random() * (SAFE.x1 - SAFE.x0);
		y = SAFE.y0 + random() * (SAFE.y1 - SAFE.y0);
		if (claimed.every((box) => overlapArea({ x, y, w: 1, h: 1 }, box, 40) === 0)) break;
	}

	for (let i = 0; i < count; i++) {
		points.push({ x, y });
		x += (random() - 0.5) * 150;
		y += (random() - 0.5) * 120;
	}
	return { strokes: [points], stars: points };
});

const constellations = [...words, ...chains];
const linkedStars = constellations.flatMap((item) => item.stars);

const scatter = Array.from({ length: 260 }, () => ({
	x: random() * FIELD_W,
	y: random() * FIELD_H,
	r: 0.5 + random() * 1.15,
	o: 0.25 + random() * 0.6,
})).filter((star) =>
	linkedStars.every((linked) => Math.hypot(linked.x - star.x, linked.y - star.y) > 14),
);

const toPoints = (points: Point[]) =>
	points.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ');
---

