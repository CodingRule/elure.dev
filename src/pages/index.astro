---
import { getCollection } from 'astro:content';
import BlackHole from '../components/BlackHole.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_DESCRIPTION } from '../consts';

const includeDrafts = import.meta.env.DEV;
const articles = (await getCollection('blog', ({ data }) => includeDrafts || !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const readingMinutes = (body = '') =>
	Math.max(1, Math.ceil(body.trim().split(/\s+/).filter(Boolean).length / 220));
const workEntries = (await getCollection('work', ({ data }) => includeDrafts || !data.draft)).sort(
	(a, b) =>
		Number(b.data.featured) - Number(a.data.featured) ||
		b.data.start.valueOf() - a.data.start.valueOf(),
);
const workYear = (value: Date) => value.getUTCFullYear();
const workPeriod = (start: Date, end?: Date) =>
	end
		? workYear(start) === workYear(end)
			? `${workYear(start)}`
			: `${workYear(start)} - ${workYear(end)}`
		: `${workYear(start)} - Present`;
---

<SiteLayout title="elure - Mihnea-Luca Mărășescu" description={SITE_DESCRIPTION}>
	<section class="hero" aria-labelledby="hero-title">
		<BlackHole />
		<div class="shell hero-inner">
			<div class="hero-copy">
				<p class="identity-line">Mihnea-Luca “elure” Mărășescu · elure.dev</p>
				<h1 id="hero-title">
					Security researcher.
					<span>CTFs, software, hardware, and infrastructure.</span>
				</h1>
				<p class="hero-description">
					I’m a Romanian high-schooler, CTF competitor, and vulnerability researcher.
					I founded OmniCYBR, and I’m building interesting hardware.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/about#disclosures">See disclosed CVEs <span>→</span></a>
					<a class="plain-action" href="/blog">Read the writing <span>→</span></a>
				</div>
			</div>

			<div class="hero-context" aria-label="Current work">
				<p>Current work</p>
				<a href="/about">OmniCYBR <span>security organisation</span></a>
				<a href="/about#disclosures">Disclosed CVEs <span>vulnerability research</span></a>
			</div>

		</div>
	</section>

	<section id="selected-work" class="work-section" aria-labelledby="work-title">
		<div class="shell">
			<header class="work-heading">
				<p class="section-label">Selected work</p>
				<div>
					<h2 id="work-title">Where I have worked.</h2>
				</div>
			</header>

			{
				workEntries.length > 0 ? (
					<div class="case-list">
						{workEntries.slice(0, 4).map((entry) => (
							<article class="case-study">
								<p class="case-type">
									{entry.data.kind} · {workPeriod(entry.data.start, entry.data.end)}
								</p>
								<div class="case-main">
									<h3>{entry.data.title}</h3>
									<p>{entry.data.organisation}. {entry.data.description}</p>
								</div>
								<a href={`/work/${entry.id}`}>Details</a>
							</article>
						))}
						<p class="all-projects-row">
							<a class="all-projects" href="/work">View all work</a>
						</p>
					</div>
				) : (
					<div class="work-empty">
						<p>Nothing listed yet.</p>
						<span>Roles and qualifications will appear here as they are added.</span>
					</div>
				)
			}
		</div>
	</section>

	<section class="writing-section" aria-labelledby="writing-title">
		<div class="shell">
			<header class="writing-heading">
				<div>
					<p class="section-label">Recent writing</p>
					<h2 id="writing-title">Recent notes.</h2>
				</div>
				<a href="/blog">Full archive</a>
			</header>

			{
				articles.length > 0 ? (
					<div class="article-list">
						{articles.slice(0, 4).map((article) => (
							<a class="article-row" href={`/blog/${article.id}`}>
								<div>
									<p>{article.data.draft ? `Draft preview · ${article.data.category}` : article.data.category}</p>
									<h3>{article.data.title}</h3>
								</div>
								<p class="article-description">{article.data.description}</p>
								<div class="article-meta">
									<FormattedDate date={article.data.pubDate} />
									<span>{readingMinutes(article.body)} min</span>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="writing-empty">
						<p>No published notes yet.</p>
						<span>Writing will appear here when it is published.</span>
					</div>
				)
			}
		</div>
	</section>

	<section class="profile-section" aria-labelledby="profile-title">
		<div class="shell profile-grid">
			<p class="section-label">About</p>
			<div>
				<h2 id="profile-title">Security researcher, competitor, and systems builder.</h2>
				<p>
					I founded OmniCYBR and use this site to publish the vulnerabilities I find,
					writeups, and infrastructure setup.
				</p>
				<div class="profile-actions">
					<a class="button button-primary" href="/about">About Mihnea <span>→</span></a>
					<a class="plain-action" href="/writeups">Browse writeups <span>→</span></a>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		--hero-ink: #f5f3ff;
		--hero-muted: color-mix(in srgb, var(--hero-ink) 74%, #030308);
		--hero-quiet: color-mix(in srgb, var(--hero-ink) 58%, #030308);
		--hero-line: color-mix(in srgb, var(--hero-ink) 18%, transparent);
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		background: #030308;
		color: var(--hero-ink);
	}

	.hero::after {
		position: absolute;
		z-index: 1;
		inset: 0;
		background:
			linear-gradient(90deg, color-mix(in srgb, #030308 97%, transparent) 0%, color-mix(in srgb, #030308 78%, transparent) 35%, transparent 66%),
			linear-gradient(0deg, color-mix(in srgb, #030308 82%, transparent), transparent 28%);
		content: '';
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		z-index: 3;
		display: grid;
		min-height: 100svh;
		padding-top: 8.5rem;
		padding-bottom: 2rem;
		grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
		grid-template-rows: 1fr;
		align-items: center;
	}

	.hero-copy {
		max-width: 780px;
	}

	.identity-line {
		margin: 0 0 1.5rem;
		color: var(--hero-muted);
		font-size: 0.78rem;
		font-weight: 540;
		letter-spacing: 0.01em;
	}

	.hero h1 {
		max-width: 780px;
		color: var(--hero-ink);
		font-size: clamp(3.9rem, 7.7vw, 6rem);
		line-height: 0.93;
	}

	.hero h1 span {
		display: block;
		color: var(--hero-muted);
		font-weight: 470;
	}

	.hero-description {
		max-width: 620px;
		margin: 2rem 0 0;
		color: var(--hero-muted);
		font-size: clamp(1.06rem, 1.8vw, 1.25rem);
		line-height: 1.58;
	}

	.hero-actions,
	.profile-actions {
		display: flex;
		margin-top: 2rem;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.4rem;
	}


	.plain-action {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.55rem;
		color: inherit;
		font-size: 0.88rem;
		font-weight: 590;
		text-decoration: none;
	}

	.plain-action span {
		transition: transform 220ms var(--ease-out);
	}

	.plain-action:is(:hover, :focus-visible) span {
		transform: translateX(4px);
	}

	.hero-context {
		align-self: end;
		justify-self: end;
		width: min(330px, 100%);
		margin-bottom: 4rem;
		border-top: 1px solid var(--hero-line);
	}

	.hero-context > p {
		margin: 0;
		padding: 0.7rem 0;
		color: var(--hero-quiet);
		font-size: 0.75rem;
	}

	.hero-context a {
		display: flex;
		padding: 0.7rem 0;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid var(--hero-line);
		color: var(--hero-ink);
		font-size: 0.88rem;
		text-decoration: none;
	}

	.hero-context a span {
		color: var(--hero-muted);
	}

	.work-section {
		--paper-bg: #090912;
		--paper-ink: #f5f3ff;
		--paper-muted: color-mix(in srgb, var(--paper-ink) 68%, var(--paper-bg));
		--paper-line: color-mix(in srgb, var(--paper-ink) 20%, var(--paper-bg));
		padding: clamp(6rem, 10vw, 10rem) 0;
		background: var(--paper-bg);
		color: var(--paper-ink);
	}

	:global(:root[data-theme='light']) .work-section {
		--paper-bg: #f1eff4;
		--paper-ink: #1a1720;
		--paper-muted: color-mix(in srgb, var(--paper-ink) 68%, var(--paper-bg));
		--paper-line: color-mix(in srgb, var(--paper-ink) 20%, var(--paper-bg));
	}

	.section-label {
		margin: 0;
		color: currentColor;
		font-size: 0.78rem;
		font-weight: 640;
	}

	.work-heading {
		display: grid;
		margin-bottom: clamp(4rem, 8vw, 7rem);
		grid-template-columns: 0.35fr 1.65fr;
		gap: 3rem;
	}

	.work-heading h2,
	.case-main h3 {
		color: var(--paper-ink);
	}

	.work-heading h2 {
		max-width: 900px;
		font-size: clamp(3rem, 6vw, 5.6rem);
	}

	.work-heading > div > p {
		max-width: 670px;
		margin: 1.5rem 0 0;
		color: var(--paper-muted);
		font-size: 1.08rem;
	}

	.case-study {
		display: grid;
		padding: clamp(2.5rem, 5vw, 4.5rem) 0;
		grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1.25fr) minmax(140px, 0.4fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: start;
		border-top: 1px solid var(--paper-line);
	}

	.case-type {
		margin: 0.35rem 0 0;
		color: var(--paper-muted);
		font-size: 0.78rem;
		font-weight: 590;
	}

	.case-main h3 {
		font-size: clamp(2.6rem, 5vw, 4.8rem);
	}

	.case-main p {
		max-width: 620px;
		margin: 1.25rem 0 0;
		color: var(--paper-muted);
		font-size: 1.04rem;
	}

	.case-study > a {
		justify-self: end;
		margin-top: 0.45rem;
		color: var(--paper-ink);
		font-size: 0.88rem;
		font-weight: 640;
		text-decoration: none;
	}

	.all-projects-row {
		margin: 0;
		padding-top: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--paper-line);
	}

	.all-projects {
		color: var(--paper-ink);
		font-size: 0.88rem;
		font-weight: 640;
		text-decoration: none;
	}

	.work-empty {
		display: grid;
		min-height: 190px;
		padding: 2rem 0;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 2rem;
		border-top: 1px solid var(--paper-line);
		border-bottom: 1px solid var(--paper-line);
	}

	.work-empty p {
		margin: 0;
		color: var(--paper-ink);
		font-size: 1.35rem;
		font-weight: 560;
	}

	.work-empty span {
		max-width: 480px;
		color: var(--paper-muted);
		font-size: 0.88rem;
	}

	.case-study > a:is(:hover, :focus-visible),
	.all-projects:is(:hover, :focus-visible),
	.writing-heading > a:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.writing-section {
		--writing-bg: #090912;
		--writing-ink: #f5f3ff;
		--writing-muted: color-mix(in srgb, var(--writing-ink) 66%, var(--writing-bg));
		--writing-quiet: color-mix(in srgb, var(--writing-ink) 52%, var(--writing-bg));
		--writing-line: color-mix(in srgb, var(--writing-ink) 15%, transparent);
		padding: clamp(6rem, 10vw, 10rem) 0;
		background: var(--writing-bg);
		color: var(--writing-ink);
	}

	.writing-heading {
		display: flex;
		margin-bottom: 4rem;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
	}

	.writing-heading h2 {
		max-width: 850px;
		margin-top: 1rem;
		color: var(--writing-ink);
		font-size: clamp(3rem, 6vw, 5.6rem);
	}

	.writing-heading > a {
		flex: 0 0 auto;
		color: var(--writing-muted);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.article-list {
		border-top: 1px solid var(--writing-line);
	}

	.writing-empty {
		display: grid;
		min-height: 190px;
		padding: 2rem 0;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 2rem;
		border-top: 1px solid var(--writing-line);
		border-bottom: 1px solid var(--writing-line);
	}

	.writing-empty p {
		margin: 0;
		color: var(--writing-ink);
		font-size: 1.35rem;
		font-weight: 560;
	}

	.writing-empty span {
		max-width: 480px;
		color: var(--writing-muted);
		font-size: 0.88rem;
	}

	.article-row {
		display: grid;
		min-height: 152px;
		padding: 1.5rem 0;
		grid-template-columns: minmax(240px, 1.05fr) minmax(260px, 1fr) 130px;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
		border-bottom: 1px solid var(--writing-line);
		color: inherit;
		text-decoration: none;
	}

	.article-row > div:first-child > p {
		margin: 0 0 0.6rem;
		color: var(--writing-quiet);
		font-size: 0.75rem;
	}

	.article-row h3 {
		color: var(--writing-ink);
		font-size: clamp(1.25rem, 2.2vw, 1.9rem);
		line-height: 1.1;
		transition: color 180ms ease;
	}

	.article-row:is(:hover, :focus-visible) h3 {
		color: var(--ultraviolet-hot);
	}

	.article-description {
		margin: 0;
		color: var(--writing-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.article-meta {
		display: grid;
		color: var(--writing-quiet);
		font-size: 0.75rem;
		gap: 0.2rem;
	}

	.profile-section {
		padding: clamp(6rem, 11vw, 11rem) 0;
		background: var(--deep-space);
	}

	.profile-grid {
		display: grid;
		grid-template-columns: 0.35fr 1.65fr;
		gap: 3rem;
	}

	.profile-grid h2 {
		max-width: 1000px;
		font-size: clamp(3rem, 6vw, 5.6rem);
	}

	.profile-grid > div > p {
		max-width: 670px;
		margin: 1.8rem 0 0;
		color: var(--secondary);
		font-size: 1.05rem;
	}

	@media (max-width: 1000px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero-context {
			display: none;
		}

		.case-study {
			grid-template-columns: minmax(140px, 0.35fr) minmax(0, 1fr);
		}

		.case-study > a {
			grid-column: 2;
			justify-self: start;
			margin-top: 0;
		}

		.article-row {
			grid-template-columns: 1fr 1fr 90px;
		}
	}

	@media (max-width: 760px) {
		.hero::after {
			background:
				linear-gradient(90deg, color-mix(in srgb, #030308 94%, transparent), color-mix(in srgb, #030308 60%, transparent)),
				linear-gradient(0deg, color-mix(in srgb, #030308 86%, transparent), transparent 45%);
		}

		.hero-inner {
			padding-top: 7rem;
		}

		.hero-copy {
			align-self: center;
		}

		.hero h1 {
			font-size: clamp(3.1rem, 13vw, 5rem);
		}

		.work-heading,
		.profile-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.case-study {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.case-study > a {
			grid-column: auto;
		}

		.work-empty {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.writing-heading {
			align-items: flex-start;
			flex-direction: column;
		}

		.writing-empty {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.article-row {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.article-description {
			grid-column: 1;
		}

		.article-meta {
			grid-column: 1;
			display: flex;
			gap: 1rem;
		}

	}

	@media (max-width: 520px) {
		.hero-actions,
		.profile-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.hero-actions .button,
		.profile-actions .button,
		.hero-actions .plain-action,
		.profile-actions .plain-action {
			width: 100%;
		}
	}
</style>
