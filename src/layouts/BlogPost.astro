---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CosmicNav from '../components/CosmicNav.astro';
import FormattedDate from '../components/FormattedDate.astro';
import LiquidDefs from '../components/LiquidDefs.astro';
import SiteFooter from '../components/SiteFooter.astro';

type PostData = CollectionEntry<'blog'>['data'];
type PostLink = { id: string; data: PostData } | undefined;
type Heading = { depth: number; slug: string; text: string };

interface Props extends PostData {
	headings?: Heading[];
	readingTime?: number;
	previous?: PostLink;
	next?: PostLink;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	draft,
	headings = [],
	readingTime = 5,
	previous,
	next,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} - elure`} description={description} image={heroImage} type="article" />
	</head>
	<body>
		<a class="skip-link" href="#article-content">Skip to article</a>
		<LiquidDefs />
		<CosmicNav />
		<div class="reading-progress" data-reading-progress aria-hidden="true"><i></i></div>
		<span class="sr-only" data-copy-status aria-live="polite"></span>
		{
			draft && (
				<div class="draft-preview-banner" role="status">
					Draft preview · not included in production
				</div>
			)
		}

		<main>
			<article>
				<header class="article-header">
					<div class="shell">
						<div class="article-title">
							<a class="back-link" href="/blog">← Publication archive</a>
							<p class="category">{category}</p>
							<h1>{title}</h1>
							<p class="description">{description}</p>
							<div class="byline">
								<strong>Mihnea-Luca “elure” Mărășescu</strong>
								<p class="mono">
									<FormattedDate date={pubDate} /> · {readingTime} MIN READ
									{updatedDate && <Fragment> · UPDATED <FormattedDate date={updatedDate} /></Fragment>}
								</p>
							</div>
						</div>
					</div>
				</header>

				<div class="shell article-layout">
					{
						tocHeadings.length > 0 && (
							<details class="toc-mobile">
								<summary>On this page<span aria-hidden="true">+</span></summary>
								<nav aria-label="Table of contents">
									{tocHeadings.map((heading) => (
										<a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
									))}
								</nav>
							</details>
						)
					}
					<aside class="toc">
						<p class="mono">ON THIS PAGE</p>
						<nav aria-label="Table of contents">
							{
								tocHeadings.map((heading) => (
									<a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
								))
							}
						</nav>
						<div class="share-controls">
							<p class="mono">SHARE</p>
							<button type="button" data-copy-link>Copy link</button>
							<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}>LinkedIn</a>
						</div>
					</aside>

					<div id="article-content" class="prose">
						<slot />
						<footer class="article-tags">
							<p class="mono">FILED UNDER</p>
							<div>{tags.map((tag) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
						</footer>
					</div>
				</div>

				<nav class="shell post-navigation" aria-label="Adjacent articles">
					{
						previous ? (
							<a href={`/blog/${previous.id}`}>
								<span class="mono">PREVIOUS</span>
								<strong>{previous.data.title}</strong>
							</a>
						) : <span></span>
					}
					{
						next && (
							<a class="next" href={`/blog/${next.id}`}>
								<span class="mono">NEXT</span>
								<strong>{next.data.title}</strong>
							</a>
						)
					}
				</nav>
			</article>
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	const progress = document.querySelector<HTMLElement>('[data-reading-progress] i');
	const article = document.querySelector<HTMLElement>('#article-content');
	let progressFrame = 0;

	const updateProgress = () => {
		progressFrame = 0;
		if (!progress || !article) return;
		const rect = article.getBoundingClientRect();
		const available = rect.height - innerHeight;
		const amount = Math.min(1, Math.max(0, -rect.top / Math.max(available, 1)));
		progress.style.transform = `scaleX(${amount})`;
	};

	const requestProgressUpdate = () => {
		if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
	};

	requestProgressUpdate();
	addEventListener('scroll', requestProgressUpdate, { passive: true });
	addEventListener('resize', requestProgressUpdate, { passive: true });

	const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
	const copyResetTimers = new WeakMap<HTMLButtonElement, number>();
	const idleStates = new WeakMap<HTMLButtonElement, { text: string; label: string | null }>();

	const idleStateOf = (button: HTMLButtonElement) => {
		if (!idleStates.has(button)) {
			idleStates.set(button, {
				text: button.textContent || 'Copy',
				label: button.getAttribute('aria-label'),
			});
		}
		return idleStates.get(button)!;
	};

	const copyToClipboard = async (
		value: string,
		button: HTMLButtonElement,
		kind: 'link' | 'code',
	) => {
		const isCode = kind === 'code';
		const idle = idleStateOf(button);
		const existingTimer = copyResetTimers.get(button);
		if (existingTimer) clearTimeout(existingTimer);
		if (copyStatus) copyStatus.textContent = '';

		let copied = false;
		try {
			if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
			await navigator.clipboard.writeText(value);
			copied = true;
		} catch {
			copied = false;
		}

		if (isCode) {
			button.classList.toggle('copied', copied);
			button.classList.toggle('failed', !copied);
			button.setAttribute('aria-label', copied ? 'Code copied' : 'Unable to copy code. Try again.');
		} else {
			button.textContent = copied ? 'Copied' : 'Copy failed';
			button.setAttribute('aria-label', copied ? 'Link copied' : 'Unable to copy link. Try again.');
		}

		if (copyStatus) {
			if (copied) copyStatus.textContent = isCode ? 'Code copied.' : 'Link copied.';
			else {
				copyStatus.textContent = isCode
					? 'Unable to copy the code. Please try again.'
					: 'Unable to copy the link. Please try again.';
			}
		}

		const resetTimer = window.setTimeout(() => {
			if (isCode) button.classList.remove('copied', 'failed');
			else button.textContent = idle.text;
			if (idle.label) button.setAttribute('aria-label', idle.label);
			else button.removeAttribute('aria-label');
			copyResetTimers.delete(button);
		}, 1800);
		copyResetTimers.set(button, resetTimer);
	};

	document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		void copyToClipboard(location.href, button, 'link');
	});

	const copyGlyphs = `
		<svg class="glyph-copy" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="9" y="9" width="11.5" height="11.5" rx="2.6"></rect>
			<path d="M5.6 15H5a1.6 1.6 0 0 1-1.6-1.6V5A1.6 1.6 0 0 1 5 3.4h8.4A1.6 1.6 0 0 1 15 5v.6"></path>
		</svg>
		<svg class="glyph-check" viewBox="0 0 24 24" aria-hidden="true">
			<path d="m5 12.6 4.6 4.6L19 7.8"></path>
		</svg>
	`;

	document.querySelectorAll<HTMLElement>('pre').forEach((pre) => {
		const code = pre.querySelector<HTMLElement>('code');
		if (!code) return;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-code';
		button.innerHTML = copyGlyphs;
		button.setAttribute('aria-label', 'Copy code');
		button.addEventListener('click', () => {
			void copyToClipboard(code.textContent || '', button, 'code');
		});
		pre.append(button);
	});
</script>

<style>
	.skip-link {
		position: fixed;
		z-index: 1000;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.7rem 1rem;
		border-radius: 12px;
		background: var(--starlight);
		color: var(--void);
		transform: translateY(-160%);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.reading-progress {
		position: fixed;
		z-index: 150;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
	}

	.reading-progress i {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--ultraviolet-hot);
		transform: scaleX(0);
		transform-origin: left;
	}

	.draft-preview-banner {
		position: absolute;
		z-index: 90;
		top: 5rem;
		left: 0;
		width: 100%;
		padding: 0.5rem 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--deep-space);
		color: var(--secondary);
		font-size: 0.78rem;
		text-align: center;
	}

	.article-header {
		padding: 12rem 0 6rem;
		border-bottom: 1px solid var(--line);
		background: var(--void);
	}

	.article-title {
		max-width: 900px;
		margin-inline: auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 5rem;
		color: var(--secondary);
		font-size: 0.82rem;
		text-decoration: none;
	}

	.category {
		margin: 0 0 1.2rem;
		color: var(--ultraviolet-hot);
		font-size: 0.78rem;
		font-weight: 580;
	}

	h1 {
		font-size: clamp(3rem, 6vw, 5.6rem);
	}

	.description {
		max-width: 760px;
		margin: 1.6rem 0 2rem;
		color: var(--secondary);
		font-size: clamp(1.06rem, 1.8vw, 1.25rem);
	}

	.byline strong {
		font-size: 0.86rem;
	}

	.byline p {
		margin: 0.15rem 0 0;
		color: var(--quiet);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	.article-layout {
		display: grid;
		padding-top: 6rem;
		grid-template-columns: 220px minmax(0, var(--reading)) 1fr;
		gap: clamp(3rem, 7vw, 8rem);
	}

	.toc {
		position: sticky;
		top: 7rem;
		height: max-content;
	}

	.toc-mobile {
		display: none;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--deep-space);
	}

	.toc-mobile summary {
		display: flex;
		min-height: 52px;
		padding: 0 1rem;
		align-items: center;
		justify-content: space-between;
		color: var(--starlight);
		font-size: 0.88rem;
		font-weight: 590;
		cursor: pointer;
		list-style: none;
	}

	.toc-mobile summary::-webkit-details-marker {
		display: none;
	}

	.toc-mobile summary span {
		color: var(--secondary);
		font-size: 1.0625rem;
		transition: transform 240ms var(--ease-out);
	}

	.toc-mobile[open] summary span {
		transform: rotate(45deg);
	}

	.toc-mobile nav {
		display: grid;
		padding: 0 1rem 0.75rem;
	}

	.toc-mobile nav a {
		display: flex;
		min-height: 42px;
		align-items: center;
		color: var(--secondary);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.toc-mobile nav .depth-3 {
		padding-left: 0.9rem;
	}

	.toc > p,
	.share-controls > p,
	.article-tags > p {
		margin: 0 0 1rem;
		color: var(--quiet);
		font-size: 0.72rem;
		letter-spacing: 0.07em;
	}

	.toc nav {
		display: grid;
		gap: 0.55rem;
	}

	.toc nav a {
		color: var(--quiet);
		font-size: 0.78rem;
		line-height: 1.4;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.toc nav a:hover {
		color: var(--starlight);
	}

	.toc nav .depth-3 {
		padding-left: 0.75rem;
	}

	.share-controls {
		display: grid;
		margin-top: 2.5rem;
		gap: 0.45rem;
	}

	.share-controls button,
	.share-controls a {
		display: inline-flex;
		width: max-content;
		min-height: 44px;
		padding: 0 0.2rem;
		align-items: center;
		border: 0;
		background: transparent;
		color: var(--secondary);
		font-size: 0.76rem;
		text-decoration: none;
		cursor: pointer;
	}

	.prose {
		grid-column: 2;
		min-width: 0;
		padding-bottom: 5rem;
		color: color-mix(in srgb, var(--starlight) 88%, var(--secondary));
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.prose :global(h2) {
		margin: 4.5rem 0 1.2rem;
		font-size: clamp(1.25rem, 2.2vw, 1.9rem);
	}

	.prose :global(h3) {
		margin: 3rem 0 0.8rem;
		font-size: 1.35rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-top: 0;
		margin-bottom: 1.65rem;
	}

	.prose :global(li) {
		margin-bottom: 0.45rem;
	}

	.prose :global(a) {
		color: var(--ultraviolet-hot);
		font-weight: 560;
	}

	.prose :global(pre) {
		padding-top: 2.6rem;
	}

	.prose :global(.copy-code) {
		position: absolute;
		z-index: 2;
		top: 0.6rem;
		right: 0.6rem;
		display: inline-flex;
		width: 30px;
		height: 30px;
		padding: 0;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.03);
		color: #aaa6b8;
		cursor: pointer;
		opacity: 0.5;
		transition:
			opacity 200ms ease,
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.prose :global(.copy-code::before) {
		position: absolute;
		inset: -7px;
		content: '';
	}

	.prose :global(pre:hover .copy-code),
	.prose :global(pre:focus-within .copy-code),
	.prose :global(.copy-code.copied),
	.prose :global(.copy-code.failed) {
		opacity: 1;
	}

	.prose :global(.copy-code:hover) {
		border-color: rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.08);
		color: #f5f3ff;
	}

	.prose :global(.copy-code svg) {
		position: absolute;
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
		transition:
			opacity 200ms ease,
			transform 280ms var(--ease-out);
	}

	.prose :global(.copy-code .glyph-check) {
		opacity: 0;
		transform: scale(0.55);
	}

	.prose :global(.copy-code.copied .glyph-copy) {
		opacity: 0;
		transform: scale(0.55);
	}

	.prose :global(.copy-code.copied .glyph-check) {
		opacity: 1;
		transform: scale(1);
	}

	.prose :global(.copy-code.copied) {
		border-color: color-mix(in srgb, var(--ultraviolet-hot) 60%, transparent);
		color: var(--ultraviolet-hot);
	}

	.prose :global(.copy-code.failed) {
		border-color: color-mix(in srgb, var(--danger) 60%, transparent);
		color: var(--danger);
	}

	@media (hover: none) {
		.prose :global(.copy-code) {
			opacity: 1;
		}
	}

	.article-tags {
		margin-top: 5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.article-tags > div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.article-tags a {
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--secondary);
		font-size: 0.75rem;
		text-decoration: none;
	}

	.post-navigation {
		display: grid;
		padding: 4rem 0 8rem;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		border-top: 1px solid var(--line);
	}

	.post-navigation > a {
		display: grid;
		min-height: 160px;
		padding: 1.4rem;
		align-content: space-between;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--deep-space);
		color: var(--starlight);
		text-decoration: none;
		transition: border-color 180ms ease;
	}

	.post-navigation > a:hover {
		border-color: var(--ultraviolet);
	}

	.post-navigation span {
		color: var(--quiet);
		font-size: 0.72rem;
	}

	.post-navigation strong {
		max-width: 480px;
		font-size: 1.0625rem;
	}

	.post-navigation .next {
		text-align: right;
	}

	@media (max-width: 1050px) {
		.article-layout {
			grid-template-columns: minmax(0, var(--reading));
			justify-content: center;
		}

		.toc {
			position: relative;
			top: auto;
			display: none;
		}

		.toc-mobile {
			display: block;
		}

		.prose {
			grid-column: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-mobile summary span,
		.prose :global(.copy-code),
		.prose :global(.copy-code svg) {
			transition: none;
		}
	}

	@media (max-width: 640px) {
		.article-header {
			padding: 9rem 0 4rem;
		}

		.back-link {
			margin-bottom: 3rem;
		}

		.article-layout {
			padding-top: 3.5rem;
		}

		.prose {
			font-size: 1rem;
		}

		.post-navigation {
			grid-template-columns: 1fr;
		}

		.post-navigation .next {
			text-align: left;
		}
	}
</style>
