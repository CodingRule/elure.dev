---
const links = [
	{ href: '/work', label: 'Work', icon: 'work', shift: '0rem', drop: '0rem' },
	{ href: '/blog', label: 'Writing', icon: 'writing', shift: '2.4rem', drop: '0.5rem' },
	{ href: '/writeups', label: 'Writeups', icon: 'writeups', shift: '0.9rem', drop: '0.35rem' },
	{ href: '/about', label: 'About', icon: 'about', shift: '3.1rem', drop: '0.4rem' },
];
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div class="footer-brand">
			<a href="/" aria-label="Elure home">
