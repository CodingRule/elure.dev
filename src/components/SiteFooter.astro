				</svg>
			</a>
		</div>

		<nav class="footer-nav" aria-label="Footer navigation" data-footer-nav>
			{
				links.map((link) => (
					<a href={link.href} style={`--shift:${link.shift};--drop:${link.drop}`}>
						<span class="link-icon" aria-hidden="true">
							{link.icon === 'work' && (
								<svg viewBox="0 0 24 24">
									<rect x="3" y="7.5" width="18" height="12.5" rx="2.5" />
									<path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3 12.5h18" />
								</svg>
							)}
							{link.icon === 'writing' && (
								<svg viewBox="0 0 24 24">
									<path d="M5 20h14M6.5 16.2 16.8 5.9a2.1 2.1 0 0 1 3 3L9.5 19.2l-4 1 1-4Z" />
								</svg>
							)}
							{link.icon === 'writeups' && (
								<svg viewBox="0 0 24 24">
									<path d="M4 4.5h11l1.6 2.4H20v8.6h-9L9.4 13H4z" />
									<path d="M4 13v7" />
								</svg>
							)}
							{link.icon === 'about' && (
								<svg viewBox="0 0 24 24">
									<circle cx="12" cy="8.5" r="3.8" />
									<path d="M4.8 20a7.4 7.4 0 0 1 14.4 0" />
								</svg>
							)}
						</span>
						<span class="link-label">{link.label}</span>
					</a>
				))
			}
		</nav>

		<div class="footer-meta">
			<a class="footer-email" href="mailto:mihnea@elure.dev">
				<span class="link-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<rect x="3" y="5.5" width="18" height="13" rx="2.5" />
						<path d="m3.8 7 7.3 5.4a1.5 1.5 0 0 0 1.8 0L20.2 7" />
					</svg>
				</span>
				mihnea@elure.dev
			</a>
			<div>
				<a href="/rss.xml">RSS</a>
				<a href="/search">Search</a>
			</div>
			<p>© {new Date().getFullYear()} Mihnea-Luca Mărășescu</p>
		</div>
	</div>
</footer>

<script>
	const nav = document.querySelector<HTMLElement>('[data-footer-nav]');

	if (nav) {
		const links = [...nav.querySelectorAll<HTMLElement>('a')];
		const BOX_HEIGHT = 190;
		const GAP = 8;

		const overlaps = (a: DOMRect, b: DOMRect) =>
			a.left - GAP < b.right && a.right + GAP > b.left && a.top - GAP < b.bottom && a.bottom + GAP > b.top;

		const scatter = () => {
			nav.classList.remove('scattered');
			links.forEach((link) => {
				link.style.left = '';
				link.style.top = '';
			});

			const boxWidth = nav.clientWidth;
			const sizes = links.map((link) => ({
				w: link.offsetWidth,
				h: link.offsetHeight,
			}));
			const widest = Math.max(...sizes.map((size) => size.w));

			if (boxWidth < widest + 40) return;

			const placed: DOMRect[] = [];
			nav.classList.add('scattered');

			links.forEach((link, index) => {
				const { w, h } = sizes[index];
				const spanX = Math.max(0, boxWidth - w);
				const spanY = Math.max(0, BOX_HEIGHT - h);
				let best = { x: 0, y: 0, score: Number.POSITIVE_INFINITY };

				for (let attempt = 0; attempt < 200; attempt++) {
					const x = Math.random() * spanX;
					const y = Math.random() * spanY;
					const rect = new DOMRect(x, y, w, h);
					const clashes = placed.filter((other) => overlaps(rect, other)).length;
					if (clashes < best.score) best = { x, y, score: clashes };
					if (clashes === 0) break;
				}

				placed.push(new DOMRect(best.x, best.y, w, h));
				link.style.left = `${best.x}px`;
				link.style.top = `${best.y}px`;
			});
		};

		scatter();

		let resizeFrame = 0;
		addEventListener('resize', () => {
			clearTimeout(resizeFrame);
			resizeFrame = window.setTimeout(scatter, 160);
		});
	}
</script>

<style>
	.site-footer {
		padding: 4.5rem 0 2.5rem;
		border-top: 1px solid var(--line);
		background: var(--deep-space);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.35fr 0.65fr 0.9fr;
		gap: clamp(2.5rem, 7vw, 7rem);
	}

	.footer-brand > a {
		display: inline-block;
		color: var(--starlight);
		line-height: 0;
		text-decoration: none;
	}

	.footer-mark {
		display: block;
		width: 38px;
		height: 38px;
		fill: currentColor;
		transition: opacity 180ms ease;
	}

	.footer-brand > a:is(:hover, :focus-visible) .footer-mark {
		opacity: 0.7;
	}

	.footer-nav {
		display: grid;
		align-content: start;
		gap: 0.15rem;
	}

	.footer-nav.scattered {
		position: relative;
		display: block;
		height: 190px;
	}

	.footer-nav.scattered a {
		position: absolute;
		transform: none;
	}

	.footer-nav.scattered a:is(:hover, :focus-visible) {
		transform: translateX(0.3rem);
	}

	.footer-nav a {
		display: inline-flex;
		width: max-content;
		min-height: 40px;
		align-items: center;
		gap: 0.6rem;
		color: var(--secondary);
		font-size: 0.86rem;
		text-decoration: none;
		transform: translate(var(--shift, 0), var(--drop, 0));
		transition:
			color 160ms ease,
			transform 260ms var(--ease-out);
	}

	.footer-nav a:is(:hover, :focus-visible) {
		color: var(--starlight);
		transform: translate(calc(var(--shift, 0rem) + 0.3rem), var(--drop, 0));
	}

	.link-icon {
		display: inline-flex;
		width: 17px;
		height: 17px;
		flex: 0 0 auto;
	}

	.link-icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.footer-meta {
		display: grid;
		align-content: start;
		justify-items: end;
		gap: 0.9rem;
		color: var(--secondary);
		font-size: 0.77rem;
		text-align: right;
	}

	.footer-meta p {
		margin: 0;
	}

	.footer-email {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		gap: 0.5rem;
		color: var(--starlight);
		font-size: 0.86rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.footer-email:is(:hover, :focus-visible) {
		color: var(--ultraviolet-hot);
	}

	.footer-meta > div {
		display: flex;
		gap: 1rem;
	}

	.footer-meta a {
		color: var(--secondary);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.footer-meta a:hover {
		color: var(--starlight);
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-meta {
			grid-column: 1 / -1;
			justify-items: start;
			text-align: left;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.footer-meta {
			grid-column: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-nav a,
		.footer-mark {
			transition: none;
		}

		.footer-nav a:is(:hover, :focus-visible) {
			transform: translate(var(--shift, 0), var(--drop, 0));
		}
	}
</style>
