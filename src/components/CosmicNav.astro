---
const pathname = Astro.url.pathname;
const links = [
	{ href: '/work', label: 'Work', matches: ['/work'] },
	{ href: '/blog', label: 'Writing', matches: ['/blog', '/writeups'] },
	{ href: '/about', label: 'About', matches: ['/about'] },
];

const active = (matches: string[]) => matches.some((path) => pathname.startsWith(path));

const lensMap =
	"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'1120'%20height%3D'72'%3E%3Cdefs%3E%3ClinearGradient%20id%3D'gx'%20x1%3D'0'%20x2%3D'1'%20y1%3D'0'%20y2%3D'0'%3E%3Cstop%20offset%3D'0'%20stop-color%3D'%23ff0000'%2F%3E%3Cstop%20offset%3D'1'%20stop-color%3D'%23000000'%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D'gy'%20x1%3D'0'%20x2%3D'0'%20y1%3D'0'%20y2%3D'1'%3E%3Cstop%20offset%3D'0'%20stop-color%3D'%2300ff00'%2F%3E%3Cstop%20offset%3D'1'%20stop-color%3D'%23000000'%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D'1120'%20height%3D'72'%20fill%3D'%23000000'%2F%3E%3Crect%20width%3D'1120'%20height%3D'72'%20fill%3D'url(%23gx)'%2F%3E%3Crect%20width%3D'1120'%20height%3D'72'%20fill%3D'url(%23gy)'%20style%3D'mix-blend-mode%3Ascreen'%2F%3E%3Crect%20x%3D'14'%20y%3D'14'%20width%3D'1092'%20height%3D'44'%20rx%3D'22'%20fill%3D'%23808080'%20style%3D'filter%3Ablur(11px)'%2F%3E%3C%2Fsvg%3E";
---

<header class="nav-stage" data-nav-stage data-at-top="true">
	<svg class="liquid-defs" width="0" height="0" aria-hidden="true" focusable="false">
		<filter id="liquid-lens" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
			<feImage href={lensMap} preserveAspectRatio="none" result="map"></feImage>
			<feDisplacementMap
				in="SourceGraphic"
				in2="map"
				scale="72"
				xChannelSelector="R"
				yChannelSelector="G"></feDisplacementMap>
			<feGaussianBlur stdDeviation="0.6"></feGaussianBlur>
		</filter>
	</svg>

	<nav class="top-nav" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label="Elure home">
			<!-- viewBox is cropped to the glyph bounds so the mark fills its box. -->
			<svg class="brand-mark" viewBox="263 245 500 500" aria-hidden="true" focusable="false">
				<path d="M 500.50 701.96 L 414.50 701.42 L 404.50 698.78 C385.57,693.79 372.38,688.19 358.50,679.23 C325.27,657.80 302.45,624.31 294.35,585.10 C292.17,574.53 291.75,569.84 291.74,556.00 C291.72,538.14 293.35,527.52 298.56,511.50 C318.74,449.46 377.04,408.67 441.84,411.28 C464.46,412.19 478.95,415.89 499.50,426.01 C527.93,440.00 549.49,461.87 564.08,491.47 C575.26,514.16 579.69,536.00 578.75,563.86 L 578.24 579.22 L 575.10 582.36 L 571.96 585.50 L 483.80 585.77 C433.56,585.92 395.25,585.65 394.75,585.15 C393.77,584.17 418.09,534.71 420.21,533.33 C420.92,532.87 444.00,532.28 471.50,532.00 L 521.50 531.50 L 521.33 528.85 C521.09,525.31 515.12,512.53 510.34,505.33 C482.81,463.85 426.42,452.91 385.00,481.01 C364.79,494.72 350.63,516.65 346.31,540.93 C344.40,551.67 345.11,569.36 347.87,580.00 C350.16,588.82 355.53,600.98 360.11,607.71 C369.69,621.80 388.55,636.98 403.75,642.84 C418.89,648.68 421.23,648.84 493.64,649.09 L 559.78 649.31 L 561.48 652.91 C568.23,667.17 584.37,685.12 599.39,695.07 C604.68,698.57 607.72,701.15 606.89,701.44 C604.15,702.40 585.25,702.49 500.50,701.96 ZM 653.00 700.51 C627.39,695.40 602.65,680.80 587.33,661.75 C575.47,647.01 567.41,626.42 566.78,609.28 L 566.50 601.51 L 572.25 600.89 C582.58,599.77 590.82,591.98 593.05,581.26 C594.98,571.95 593.76,533.61 591.17,522.45 C586.78,503.52 577.63,480.85 569.65,469.15 L 566.00 463.80 L 566.00 400.56 C566.00,340.62 566.10,336.91 568.00,329.51 C573.91,306.38 592.06,290.43 615.73,287.57 L 620.97 286.94 L 620.32 443.79 C619.81,567.61 619.93,602.00 620.92,607.07 C623.59,620.71 635.11,636.14 647.50,642.65 C659.87,649.16 661.08,649.32 699.37,649.76 L 734.24 650.16 L 733.81 658.99 C733.45,666.71 732.92,668.78 729.65,675.39 C723.60,687.64 713.67,696.43 701.66,700.18 C696.85,701.68 692.62,701.98 677.66,701.91 C667.18,701.85 656.75,701.26 653.00,700.51 Z" />
			</svg>
		</a>

		<div class="desktop-links">
			{
				links.map((link) => (
					<a href={link.href} aria-current={active(link.matches) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</div>

		<div class="nav-actions">
			<form class="nav-search" action="/search" method="get" role="search" data-nav-search>
				<input
					class="search-input"
					type="search"
					name="q"
					placeholder="Search…"
					aria-label="Search articles and projects"
					autocomplete="off"
					tabindex="-1"
				/>
				<button class="search-toggle" type="button" aria-expanded="false" aria-label="Open search">
					<svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="11" cy="11" r="6.5"></circle>
						<path d="m15.8 15.8 4.45 4.45"></path>
					</svg>
				</button>
			</form>
			<button
				class="theme-toggle"
				type="button"
				aria-label="Use light theme"
				aria-pressed="false"
			>
				<svg class="action-icon theme-icon" viewBox="0 0 24 24" aria-hidden="true">
					<g class="sun-shape">
						<circle cx="12" cy="12" r="3.4"></circle>
						<path d="M12 2.25v2.1M12 19.65v2.1M4.45 4.45l1.48 1.48M18.07 18.07l1.48 1.48M2.25 12h2.1M19.65 12h2.1M4.45 19.55l1.48-1.48M18.07 5.93l1.48-1.48"></path>
					</g>
					<path class="moon-shape" d="M20 15.4A8.5 8.5 0 0 1 8.6 4a8.6 8.6 0 1 0 11.4 11.4Z"></path>
				</svg>
			</button>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
				<span></span><span></span>
				<span class="sr-only">Open navigation</span>
			</button>
		</div>
	</nav>

	<div id="mobile-nav" class="mobile-panel" hidden>
		{
			links.map((link) => (
				<a href={link.href} aria-current={active(link.matches) ? 'page' : undefined}>
					{link.label}<span aria-hidden="true">→</span>
				</a>
			))
		}
		<a href="/search">Search<span aria-hidden="true">→</span></a>
	</div>
</header>

<script>
	const stage = document.querySelector<HTMLElement>('[data-nav-stage]');
	const toggle = stage?.querySelector<HTMLButtonElement>('.menu-toggle');
	const panel = stage?.querySelector<HTMLElement>('#mobile-nav');
	const theme = stage?.querySelector<HTMLButtonElement>('.theme-toggle');
	const searchForm = stage?.querySelector<HTMLFormElement>('[data-nav-search]');
	const searchInput = searchForm?.querySelector<HTMLInputElement>('.search-input');
	const searchToggle = searchForm?.querySelector<HTMLButtonElement>('.search-toggle');
	const desktopQuery = matchMedia('(min-width: 821px)');
	const reducedMotionQuery = matchMedia('(prefers-reduced-motion: reduce)');
	let menuOpen = false;
	let searchOpen = false;
	let themeTransitionTimer = 0;
	let condensed = false;
	let scrollFrame = 0;

	const syncNavState = () => {
		scrollFrame = 0;
		if (!stage) return;
		const y = window.scrollY;
		if (condensed && y < 14) {
			condensed = false;
			stage.dataset.atTop = 'true';
		} else if (!condensed && y > 56) {
			condensed = true;
			stage.dataset.atTop = 'false';
		}
	};

	syncNavState();
	addEventListener(
		'scroll',
		() => {
			if (!scrollFrame) scrollFrame = requestAnimationFrame(syncNavState);
		},
		{ passive: true },
	);

	const openSearch = () => {
		if (!searchForm || !searchInput || !searchToggle || searchOpen) return;
		searchOpen = true;
		searchForm.classList.add('open');
		searchToggle.setAttribute('aria-expanded', 'true');
		searchToggle.setAttribute('aria-label', 'Submit search');
		searchInput.removeAttribute('tabindex');
		searchInput.focus();
	};

	const closeSearch = (returnFocus = false) => {
		if (!searchForm || !searchInput || !searchToggle || !searchOpen) return;
		searchOpen = false;
		searchForm.classList.remove('open');
		searchToggle.setAttribute('aria-expanded', 'false');
		searchToggle.setAttribute('aria-label', 'Open search');
		searchInput.value = '';
		searchInput.setAttribute('tabindex', '-1');
		if (returnFocus) searchToggle.focus();
	};

	searchToggle?.addEventListener('click', () => {
		if (!searchOpen) {
			openSearch();
		} else if (searchInput?.value.trim()) {
			searchForm?.submit();
		} else {
			closeSearch(true);
		}
	});

	searchInput?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			event.stopPropagation();
			closeSearch(true);
		} else if (event.key === 'Enter') {
			event.preventDefault();
			if (searchInput.value.trim()) searchForm?.submit();
		}
	});

	searchForm?.addEventListener('focusout', (event) => {
		if (
			searchOpen &&
			!searchInput?.value.trim() &&
			!(event.relatedTarget instanceof Node && searchForm.contains(event.relatedTarget))
		) {
			closeSearch();
		}
	});

	const closeMenu = (returnFocus = false) => {
		if (!panel || !toggle || !menuOpen) return;
		menuOpen = false;
		panel.hidden = true;
		toggle.setAttribute('aria-expanded', 'false');
		toggle.querySelector('.sr-only')!.textContent = 'Open navigation';
		document.body.classList.remove('menu-open');
		if (returnFocus) toggle.focus();
	};

	const openMenu = () => {
		if (!panel || !toggle) return;
		menuOpen = true;
		panel.hidden = false;
		toggle.setAttribute('aria-expanded', 'true');
		toggle.querySelector('.sr-only')!.textContent = 'Close navigation';
		document.body.classList.add('menu-open');
		panel.querySelector<HTMLAnchorElement>('a')?.focus();
	};

	const syncThemeControl = () => {
		if (!theme) return;
		const light = document.documentElement.dataset.theme === 'light';
		theme.setAttribute('aria-pressed', String(light));
		theme.setAttribute('aria-label', light ? 'Use dark theme' : 'Use light theme');
	};

	syncThemeControl();
	toggle?.addEventListener('click', () => (menuOpen ? closeMenu() : openMenu()));
	panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu(true);
	});

	document.addEventListener('pointerdown', (event) => {
		if (!stage || stage.contains(event.target as Node)) return;
		if (menuOpen) closeMenu();
		if (searchOpen && !searchInput?.value.trim()) closeSearch();
	});
	desktopQuery.addEventListener('change', (event) => {
		if (event.matches) closeMenu();
	});

	theme?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
		const root = document.documentElement;
		if (!reducedMotionQuery.matches) root.classList.add('theme-changing');
		if (themeTransitionTimer) clearTimeout(themeTransitionTimer);

		requestAnimationFrame(() => {
			root.dataset.theme = next;
			try {
				localStorage.setItem('elure-theme', next);
			} catch {

			}
			syncThemeControl();
			themeTransitionTimer = window.setTimeout(() => {
				root.classList.remove('theme-changing');
				themeTransitionTimer = 0;
			}, reducedMotionQuery.matches ? 0 : 560);
		});
	});
</script>

<style>
	.nav-stage {
		--nav-width: min(1120px, calc(100% - 2rem));
		--nav-height: 72px;
		--nav-radius: 22px;
		--nav-pad-left: 1.35rem;
		--nav-pad-right: 1rem;
		--nav-tint: 0.78;
		--nav-border: color-mix(in srgb, #f5f3ff 10%, transparent);
		--nav-shadow: 0 6px 24px color-mix(in srgb, #030308 14%, transparent);
		--brand-scale: 1.06;
		position: fixed;
		z-index: 100;
		top: 0;
		left: 0;
		width: 100%;
		height: 86px;
		padding-top: 0.75rem;
		pointer-events: none;
	}

	.nav-stage[data-at-top='false'] {
		--nav-width: min(900px, calc(100% - 2.5rem));
		--nav-height: 60px;
		--nav-radius: 16px;
		--nav-pad-left: 0.9rem;
		--nav-pad-right: 0.65rem;
		--nav-tint: 0.9;
		--nav-border: color-mix(in srgb, #f5f3ff 16%, transparent);
		--nav-shadow: 0 14px 40px color-mix(in srgb, #030308 30%, transparent);
		--brand-scale: 1;
	}

	.liquid-defs {
		position: absolute;
	}

	.top-nav {
		position: relative;
		display: grid;
		width: var(--nav-width);
		min-height: var(--nav-height);
		margin-inline: auto;
		padding: 0 var(--nav-pad-right) 0 var(--nav-pad-left);
		grid-template-columns: auto 1fr auto;
		align-items: center;
		border: 1px solid var(--nav-border);
		border-radius: var(--nav-radius);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, white 12%, transparent),
			var(--nav-shadow);
		color: #f5f3ff;
		pointer-events: auto;
		transition:
			width 560ms var(--ease-out),
			min-height 560ms var(--ease-out),
			padding 560ms var(--ease-out),
			border-radius 560ms var(--ease-out),
			border-color 400ms ease,
			box-shadow 560ms ease;
	}

	.top-nav::before {
		position: absolute;
		z-index: -2;
		inset: 0;
		border-radius: inherit;
		background:
			linear-gradient(150deg, color-mix(in srgb, white 9%, transparent), transparent 34%),
			color-mix(in srgb, #090912 84%, transparent);
		content: '';
		opacity: var(--nav-tint);
		pointer-events: none;
		transition: opacity 560ms ease;
		-webkit-backdrop-filter: blur(20px) saturate(145%);
		backdrop-filter: blur(20px) saturate(145%);
	}

	.top-nav::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: inherit;
		content: '';
		pointer-events: none;
		backdrop-filter: url('#liquid-lens');
	}

	.brand {
		display: inline-flex;
		align-items: center;
		color: #f5f3ff;
		line-height: 0;
		text-decoration: none;
	}

	.brand-mark {
		display: block;
		width: 30px;
		height: 30px;
		fill: currentColor;
		transform: scale(var(--brand-scale));
		transform-origin: left center;
		transition: transform 560ms var(--ease-out);
	}

	.desktop-links {
		display: flex;
		justify-content: center;
		gap: clamp(1.5rem, 3.4vw, 2.8rem);
	}

	.desktop-links a {
		position: relative;
		padding: 0.7rem 0.1rem;
		color: color-mix(in srgb, #f5f3ff 70%, #090912);
		font-size: 0.88rem;
		font-weight: 540;
		text-decoration: none;
	}

	.desktop-links a:hover,
	.desktop-links a[aria-current='page'] {
		color: #f5f3ff;
	}

	.desktop-links a[aria-current='page']::after {
		position: absolute;
		right: 0.1rem;
		bottom: 0.3rem;
		left: 0.1rem;
		height: 1px;
		background: var(--ultraviolet-hot);
		content: '';
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	.nav-search {
		display: flex;
		align-items: center;
		border-radius: 12px;
		transition: background-color 320ms ease, box-shadow 320ms ease;
	}

	.nav-search.open {
		background: color-mix(in srgb, white 6%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #f5f3ff 14%, transparent);
	}

	.search-input {
		width: 0;
		min-height: 40px;
		padding: 0;
		border: 0;
		background: transparent;
		color: #f5f3ff;
		font-size: 0.85rem;
		opacity: 0;
		transition:
			width 380ms var(--ease-out),
			padding 380ms var(--ease-out),
			opacity 240ms ease;
	}

	.search-input::placeholder {
		color: color-mix(in srgb, #f5f3ff 62%, #090912);
	}

	.search-input:focus-visible {
		outline: none;
	}

	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	.nav-search.open .search-input {
		width: clamp(150px, 24vw, 230px);
		padding: 0 0.2rem 0 0.85rem;
		opacity: 1;
	}

	.search-toggle,
	.theme-toggle,
	.menu-toggle {
		min-height: 44px;
		padding: 0;
		border: 0;
		border-radius: 12px;
		background: transparent;
		color: color-mix(in srgb, #f5f3ff 70%, #090912);
		cursor: pointer;
	}

	.search-toggle,
	.theme-toggle {
		display: inline-flex;
		width: 44px;
		align-items: center;
		justify-content: center;
	}

	.action-icon {
		width: 20px;
		height: 20px;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.55;
	}

	.theme-icon .sun-shape,
	.theme-icon .moon-shape {
		transform-box: view-box;
		transform-origin: center;
		transition:
			opacity 420ms ease,
			transform 520ms var(--ease-out) !important;
	}

	.sun-shape {
		opacity: 0;
		transform: rotate(-80deg) scale(0.45);
	}

	.moon-shape {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	:global(:root[data-theme='light']) .sun-shape {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	:global(:root[data-theme='light']) .moon-shape {
		opacity: 0;
		transform: rotate(80deg) scale(0.45);
	}

	.search-toggle:hover,
	.theme-toggle:hover,
	.menu-toggle:hover {
		background: color-mix(in srgb, var(--ultraviolet) 10%, transparent);
		color: #f5f3ff;
	}

	.nav-search.open .search-toggle:hover {
		background: transparent;
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		align-content: center;
		justify-items: center;
		gap: 6px;
	}

	.menu-toggle span:not(.sr-only) {
		width: 18px;
		height: 1px;
		background: currentColor;
		transition: transform 260ms var(--ease-out);
	}

	.menu-toggle[aria-expanded='true'] span:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(2) {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	.mobile-panel {
		position: absolute;
		z-index: 5;
		top: 82px;
		right: 1rem;
		left: 1rem;
		padding: 0.65rem;
		border: 1px solid color-mix(in srgb, #f5f3ff 15%, transparent);
		border-radius: 16px;
		background: color-mix(in srgb, #090912 96%, transparent);
		box-shadow: 0 20px 60px color-mix(in srgb, #030308 42%, transparent);
		color: #f5f3ff;
		pointer-events: auto;
		transform-origin: top right;
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
	}

	.mobile-panel:not([hidden]) {
		animation: panel-pop 320ms var(--ease-out) backwards;
	}

	@keyframes panel-pop {
		from {
			opacity: 0;
			transform: translateY(-10px) scale(0.95);
		}
	}

	.mobile-panel a {
		display: flex;
		min-height: 52px;
		padding-inline: 0.8rem;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid color-mix(in srgb, #f5f3ff 11%, transparent);
		color: color-mix(in srgb, #f5f3ff 72%, #090912);
		text-decoration: none;
	}

	.mobile-panel a:last-child {
		border-bottom: 0;
	}

	.mobile-panel a[aria-current='page'] {
		color: #f5f3ff;
	}

	@media (prefers-reduced-motion: no-preference) {
		.top-nav {
			animation: nav-arrive 640ms var(--ease-out) 80ms backwards;
		}

		@keyframes nav-arrive {
			from {
				transform: translateY(calc(-100% - 1.2rem)) scale(0.97);
			}
		}
	}

	@media (max-width: 820px) {
		.nav-stage {
			--nav-width: calc(100% - 1.2rem);
			--nav-height: 66px;
			--nav-radius: 20px;
			height: 82px;
			padding-top: 0.55rem;
		}

		.nav-stage[data-at-top='false'] {
			--nav-width: calc(100% - 1.5rem);
			--nav-height: 58px;
			--nav-radius: 16px;
		}

		.top-nav {
			grid-template-columns: auto 1fr;
		}

		.desktop-links {
			display: none;
		}

		.nav-actions {
